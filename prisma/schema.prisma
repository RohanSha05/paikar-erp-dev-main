generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum PurchaseStatus {
  DRAFT
  APPROVED
}

enum RateBasis {
  perKg
  perMon
}

enum SalesStatus {
  DRAFT
  CONFIRMED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum StockMoveReason {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
}

enum StockRefType {
  PO
  SO
  TRF
  ADJ
}

enum PartyType {
  CUSTOMER
  SELLER
  MILL
  DRIVER
  OTHER
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole @default(OPERATOR)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Seller {
  id            String   @id @default(uuid())
  name          String
  address       String?
  district      String?
  market        String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model Driver {
  id         String   @id
  name       String
  phone      String?
  truckNo    String?
  licenseNo  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trips      DriverTrip[]

  @@index([active])
}

model DriverTrip {
  id         String   @id
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverName String?
  date       DateTime
  route      String?
  truckNo    String?
  amount     Decimal  @db.Decimal(18, 4)
  memo       String?
  settled    Boolean  @default(false)
  settledAt  DateTime?
  poId       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([driverId, date])
  @@index([createdAt])
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  address       String?
  district      String?
  market        String?
  phone         String?
  type          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesOrders   SalesOrder[]
}

model Product {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  category      String?
  unit          String   @default("bag")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseItems PurchaseOrderItem[]
  lots          Lot[]
  soItems       SalesOrderItem[]

  @@index([active])
}

model Party {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  type          PartyType
  district      String?
  market        String?
  address       String?
  phone         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type])
  @@index([active])
}

model Warehouse {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  address       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lots          Lot[]
  stockMoves    StockMove[]
  purchaseOrders PurchaseOrder[]

  @@index([active])
}

model PurchaseOrder {
  id            String          @id @default(uuid())
  poNo          String          @unique
  status        PurchaseStatus  @default(DRAFT)
  purchaseType  String?
  sellerId      String
  seller        Seller          @relation(fields: [sellerId], references: [id])
  warehouseId   String
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])

  transport     Decimal         @db.Decimal(18, 4)
  loading       Decimal         @db.Decimal(18, 4)
  misc          Decimal         @db.Decimal(18, 4)
  loadingUnloading Decimal?     @db.Decimal(18, 4)
  bagCostMode   String?
  bagCostPerBag Decimal         @db.Decimal(18, 4)
  remarks       String?
  productType   String?
  varietyNote   String?
  destinationType String?
  destinationRefId String?
  destinationKind String?
  destinationWarehouseId String?
  destinationCustomerId String?
  advancePaid   Decimal?        @db.Decimal(18, 4)
  advanceInstrumentId String?
  transportMode String?
  driverId      String?
  driverName    String?
  truckNo       String?
  route         String?
  driverTripId  String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items         PurchaseOrderItem[]
  vouchers      Voucher[]
  lots          Lot[]

  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id                   String         @id @default(uuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineId               String?
  productId            String
  product              Product        @relation(fields: [productId], references: [id])
  productName          String?

  bagCount             Int
  actualKgPerBag       Decimal        @db.Decimal(18, 4)
  accountingKgPerBag   Decimal        @db.Decimal(18, 4)
  weightPolicy         String
  rateBasis            String
  rateValue            Decimal        @db.Decimal(18, 4)
  transportMode        String?
  transportCost        Decimal?       @db.Decimal(18, 4)
  loadingUnloading     Decimal?       @db.Decimal(18, 4)
  misc                 Decimal?       @db.Decimal(18, 4)
  destinationType      String?
  destinationRefId     String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Lot {
  id            String        @id @default(uuid())
  lotNo         String        @unique
  label         String        @unique
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  availableKg   Decimal       @db.Decimal(18, 4) @default(0)
  avgCostPerKg  Decimal       @db.Decimal(18, 4) @default(0)
  meta          Json?

  sourcePoId    String?
  sourcePoItemId String?
  sourcePo      PurchaseOrder? @relation(fields: [sourcePoId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stockMoves    StockMove[]
  soItems       SalesOrderItem[]

  @@index([warehouseId, productId])
  @@index([availableKg])
  @@index([createdAt])
}

model StockMove {
  id            String        @id @default(uuid())
  moveNo        String        @unique
  lotId         String
  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  qtyKg         Decimal       @db.Decimal(18, 4)
  reason        StockMoveReason
  refType       StockRefType
  refId         String
  memo          String?
  createdBy     String?
  lotLabel      String?
  createdAt     DateTime      @default(now())

  @@index([refType, refId])
  @@index([lotId, createdAt])
  @@index([warehouseId, createdAt])
}

model SalesOrder {
  id                String            @id @default(uuid())
  soNo              String            @unique
  status            SalesOrderStatus  @default(DRAFT)

  customerId        String
  customerSnapshot  Json

  transport         Decimal           @db.Decimal(14, 2) @default(0)
  loadingUnloading  Decimal           @db.Decimal(14, 2) @default(0)
  misc              Decimal           @db.Decimal(14, 2) @default(0)

  remarks           String?
  totalsJson        Json?

  confirmedAt       DateTime?
  confirmedBy       String?
  createdBy         String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             SalesOrderItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model SalesOrderItem {
  id                String      @id @default(uuid())
  salesOrderId      String
  lotId             String
  productId         String?
  productType       String

  qtyKg             Decimal     @db.Decimal(14, 3)
  rateBasis         RateBasis
  rateValue         Decimal     @db.Decimal(14, 3)
  ratePerKg         Decimal     @db.Decimal(14, 4)
  lineBase          Decimal     @db.Decimal(14, 2)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  salesOrder        SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lot               Lot         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  product           Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
  @@index([lotId])
  @@index([productId])
}

model Account {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  type          String
  partyKind     String?
  partyRefId    String?
  bankInfo      String?
  opening       Decimal?      @db.Decimal(18, 4)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  voucherRows   VoucherRow[]
}

model Voucher {
  id              String         @id @default(uuid())
  voucherNo       String         @unique
  vtype           String
  vdate           DateTime
  narration       String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId    String?
  locked          Boolean        @default(false)
  createdAt       DateTime       @default(now())

  rows            VoucherRow[]

  @@index([vdate])
}

model VoucherRow {
  id              String    @id @default(uuid())
  voucherId       String
  voucher         Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])

  dr              Decimal   @db.Decimal(18, 4)
  cr              Decimal   @db.Decimal(18, 4)
  memo            String?

  createdAt       DateTime  @default(now())

  @@index([accountId])
}