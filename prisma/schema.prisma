model RetailPurchaseDraft {
  id            String   @id @default(uuid())
  date          DateTime @db.Timestamp(3)
  sellerId      String?
  seller        Seller?  @relation(fields: [sellerId], references: [id])
  market        String?
  mon           Decimal  @db.Decimal(18, 4)
  price         Decimal  @db.Decimal(18, 4)
  bagCount      Int?
  notes         String?
  status        String   @default("DRAFT") // DRAFT or FINALIZED
  paidAmount    Decimal  @db.Decimal(18, 4)
  dueAmount     Decimal  @db.Decimal(18, 4)
  isDue         Boolean  @default(false)
  sellerName    String?  // Required if isDue is true
  sellerAddress String?  // Required if isDue is true
  sellerPhone   String?  // Required if isDue is true
  bagCostPerBag  Decimal  @default(0)
  productId     String?
  productName   String?
  productCategory String?

  poId          String? // Link to finalized PurchaseOrder
  createdBy     String?
  createdAt     DateTime @db.Timestamp(3) @default(now())
  updatedAt     DateTime @db.Timestamp(3) @updatedAt

  @@index([status, date])
  @@index([sellerId])
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum PurchaseStatus {
  DRAFT
  APPROVED
}

enum RateBasis {
  perKg
  perMon
  perBag
}

enum SalesStatus {
  DRAFT
  CONFIRMED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum StockMoveReason {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
}

enum StockRefType {
  PO
  SO
  TRF
  ADJ
}

enum VoucherStatus {
  DRAFT
  POSTED
  RECONCILED
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  REVERSE
}

enum PartyType {
  CUSTOMER
  SELLER
  MILL
  DRIVER
  INVESTOR
  EMPLOYEE
  OTHER
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole @default(OPERATOR)
  active        Boolean  @default(true)
  createdAt     DateTime @db.Timestamp(3) @default(now())
  updatedAt     DateTime @db.Timestamp(3) @updatedAt
}

model Seller {
  id            String   @id @default(uuid())
  name          String
  address       String?
  district      String?
  market        String?
  phone         String?
  nidNumber String?
emergencyPhone String?
  createdAt     DateTime @db.Timestamp(3) @default(now())
  updatedAt     DateTime @db.Timestamp(3) @updatedAt

  purchaseOrders PurchaseOrder[]
  retailPurchaseDrafts RetailPurchaseDraft[]
}

model Driver {
  id         String   @id
  name       String
  phone      String?
  truckNo    String?
  licenseNo  String?
  active     Boolean  @default(true)
  createdAt  DateTime @db.Timestamp(3) @default(now())
  updatedAt  DateTime @db.Timestamp(3) @updatedAt

  trips      DriverTrip[]

  @@index([active])
}

model DriverTrip {
  id         String   @id
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverName String?
  date       DateTime @db.Timestamp(3)
  route      String?
  truckNo    String?
  amount     Decimal  @db.Decimal(18, 4)
  memo       String?
  settled    Boolean  @default(false)
  settledAt  DateTime? @db.Timestamp(3)
  poId       String?
  createdAt  DateTime @db.Timestamp(3) @default(now())
  updatedAt  DateTime @db.Timestamp(3) @updatedAt

  @@index([driverId, date])
  @@index([createdAt])
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  address       String?
  district      String?
  market        String?
  phone         String?
  type          String?
  nidNumber String?
  emergencyPhone String?
  createdAt     DateTime @db.Timestamp(3) @default(now())
  updatedAt     DateTime @db.Timestamp(3) @updatedAt

  salesOrders   SalesOrder[]
  destinationPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderDestinationCustomer")
}

model Product {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  category      String?
  unit          String   @default("bag")
  active        Boolean  @default(true)
  createdAt     DateTime @db.Timestamp(3) @default(now())
  updatedAt     DateTime @db.Timestamp(3) @updatedAt

  purchaseItems PurchaseOrderItem[]
  lots          Lot[]
  soItems       SalesOrderItem[]

  @@index([active])
}

model Party {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  type          PartyType
  district      String?
  market        String?
  address       String?
  phone         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @db.Timestamp(3) @default(now())
  updatedAt     DateTime  @db.Timestamp(3) @updatedAt

  @@index([type])
  @@index([active])
}

model Warehouse {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  address       String?
  active        Boolean  @default(true)
  createdAt     DateTime @db.Timestamp(3) @default(now())
  updatedAt     DateTime @db.Timestamp(3) @updatedAt

  lots          Lot[]
  stockMoves    StockMove[]
  purchaseOrders PurchaseOrder[]

  @@index([active])
}

model PurchaseOrder {
  id            String          @id @default(uuid())
  poNo          String          @unique
  status        PurchaseStatus  @default(DRAFT)
  purchaseType  String?
  sellerId      String
  seller        Seller          @relation(fields: [sellerId], references: [id])
  sellerSnapshot Json?
  warehouseId   String
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])

  transport     Decimal         @db.Decimal(18, 4)
  loading       Decimal         @db.Decimal(18, 4)
  misc          Decimal         @db.Decimal(18, 4)
  loadingUnloading Decimal?     @db.Decimal(18, 4)
  bagCostMode   String?
  bagCostPerBag Decimal         @db.Decimal(18, 4)
  remarks       String?
  productType   String?
  varietyNote   String?
  destinationType String?
  destinationRefId String?
  destinationKind String?
  destinationWarehouseId String?
  destinationCustomerId String?
  destinationCustomer   Customer?       @relation("PurchaseOrderDestinationCustomer", fields: [destinationCustomerId], references: [id])
  advancePaid   Decimal?        @db.Decimal(18, 4)
  advanceInstrumentId String?
  transportMode String?
  driverId      String?
  driverName    String?
  truckNo       String?
  route         String?
  driverTripId  String?

  createdAt     DateTime        @db.Timestamp(3) @default(now())
  updatedAt     DateTime        @db.Timestamp(3) @updatedAt

  items         PurchaseOrderItem[]
  vouchers      Voucher[]
  lots          Lot[]

  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id                   String         @id @default(uuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineId               String?
  productId            String
  product              Product        @relation(fields: [productId], references: [id])
  productName          String?

  bagCount             Int
  actualKgPerBag       Decimal        @db.Decimal(18, 4)
  accountingKgPerBag   Decimal        @db.Decimal(18, 4)
  weightPolicy         String
  rateBasis            String
  rateValue            Decimal        @db.Decimal(18, 4)
  transportMode        String?
  transportCost        Decimal?       @db.Decimal(18, 4)
  loadingUnloading     Decimal?       @db.Decimal(18, 4)
  misc                 Decimal?       @db.Decimal(18, 4)
  destinationType      String?
  destinationRefId     String?

  createdAt            DateTime       @db.Timestamp(3) @default(now())
  updatedAt            DateTime       @db.Timestamp(3) @updatedAt
}

model Lot {
  id            String        @id @default(uuid())
  lotNo         String        @unique
  label         String        @unique
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  availableKg   Decimal       @db.Decimal(18, 4) @default(0)
  avgCostPerKg  Decimal       @db.Decimal(18, 4) @default(0)
  meta          Json?

  sourcePoId    String?
  sourcePoItemId String?
  sourcePo      PurchaseOrder? @relation(fields: [sourcePoId], references: [id])

  createdAt     DateTime      @db.Timestamp(3) @default(now())
  updatedAt     DateTime      @db.Timestamp(3) @updatedAt

  stockMoves    StockMove[]
  soItems       SalesOrderItem[]

  @@index([warehouseId, productId])
  @@index([availableKg])
  @@index([createdAt])
}

model StockMove {
  id            String        @id @default(uuid())
  moveNo        String        @unique
  lotId         String
  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  qtyKg         Decimal       @db.Decimal(18, 4)
  reason        StockMoveReason
  refType       StockRefType
  refId         String
  memo          String?
  createdBy     String?
  lotLabel      String?
  createdAt     DateTime      @db.Timestamp(3) @default(now())

  @@index([refType, refId])
  @@index([lotId, createdAt])
  @@index([warehouseId, createdAt])
}

model SalesOrder {
  id                String            @id @default(uuid())
  soNo              String            @unique
  status            SalesOrderStatus  @default(DRAFT)

  customerId        String
  customerSnapshot  Json
  itemsSnapshot     Json?

  transport         Decimal           @db.Decimal(14, 2) @default(0)
  loadingUnloading  Decimal           @db.Decimal(14, 2) @default(0)
  misc              Decimal           @db.Decimal(14, 2) @default(0)

  remarks           String?
  totalsJson        Json?

  confirmedAt       DateTime? @db.Timestamp(3)
  confirmedBy       String?
  createdBy         String?

  createdAt         DateTime          @db.Timestamp(3) @default(now())
  updatedAt         DateTime          @db.Timestamp(3) @updatedAt

  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             SalesOrderItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model SalesOrderItem {
  id                String      @id @default(uuid())
  salesOrderId      String
  lotId             String
  productId         String?
  productType       String

  qtyKg             Decimal     @db.Decimal(14, 3)
  rateBasis         RateBasis
  rateValue         Decimal     @db.Decimal(14, 3)
  ratePerKg         Decimal     @db.Decimal(14, 4)
  lineBase          Decimal     @db.Decimal(14, 2)
  bagCount          Int         @default(0)
  createdAt         DateTime    @db.Timestamp(3) @default(now())
  updatedAt         DateTime    @db.Timestamp(3) @updatedAt

  salesOrder        SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lot               Lot         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  product           Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
  @@index([lotId])
  @@index([productId])
}

model Account {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  type          String
  partyKind     String?
  partyRefId    String?
  bankInfo      String?
  opening       Decimal?      @db.Decimal(18, 4)
  active        Boolean       @default(true)
  createdAt     DateTime      @db.Timestamp(3) @default(now())
  updatedAt     DateTime      @db.Timestamp(3) @updatedAt

  voucherRows   VoucherRow[]
}

model Investor {
  id            String         @id
  name          String
  phone         String?
  address       String?
  nidNo         String?
  nomineeName   String?
  startDate     DateTime? @db.Timestamp(3)
  photoUrl      String?
  agreementPct  Float?
  notes         String?
  active        Boolean        @default(true)
  createdAt     DateTime       @db.Timestamp(3) @default(now())
  updatedAt     DateTime       @db.Timestamp(3) @updatedAt

  txns          InvestorTxn[]
}

model InvestorTxn {
  id            String         @id
  investorId    String
  investor      Investor       @relation(fields: [investorId], references: [id], onDelete: Cascade)
  kind          String
  date          DateTime @db.Timestamp(3)
  amount        Float
  instrument    String?
  memo          String?
  voucherId     String?
  createdAt     DateTime       @db.Timestamp(3) @default(now())

  @@index([investorId, date])
  @@index([createdAt])
}

model Voucher {
  id              String         @id @default(uuid())
  voucherNo       String         @unique
  vtype           String
  vdate           DateTime @db.Timestamp(3)
  narration       String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId    String?
  locked          Boolean        @default(false)
  status          VoucherStatus  @default(DRAFT)
  userId          String?
  postedAt        DateTime? @db.Timestamp(3)
  deletedAt       DateTime? @db.Timestamp(3)
  createdAt       DateTime       @db.Timestamp(3) @default(now())
  updatedAt       DateTime       @db.Timestamp(3) @updatedAt

  rows                  VoucherRow[]
  auditLogs             AuditLog[]
  originalReversal      VoucherReversal? @relation("OriginalVoucher")
  reversingVoucher      VoucherReversal? @relation("ReversingVoucher")

  @@index([vdate, status])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model VoucherRow {
  id              String    @id @default(uuid())
  voucherId       String
  voucher         Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  dr              Decimal   @db.Decimal(18, 4)
  cr              Decimal   @db.Decimal(18, 4)
  memo            String?

  createdAt       DateTime  @db.Timestamp(3) @default(now())

  @@index([accountId])
}

model RecurringExpenseTemplate {
  id               String   @id @default(uuid())
  name             String
  expenseAccountId String
  payFromAccountId String?
  amount           Decimal  @db.Decimal(18, 4)
  frequency        String   @default("monthly")
  dayOfMonth       Int?
  active           Boolean  @default(true)
  notes            String?
  lastPostedDate   DateTime? @db.Timestamp(3)
  createdAt        DateTime @db.Timestamp(3) @default(now())
  updatedAt        DateTime @db.Timestamp(3) @updatedAt

  posts            RecurringExpensePost[]

  @@index([active])
}

model RecurringExpensePost {
  id         String   @id @default(uuid())
  templateId  String
  template    RecurringExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  voucherId  String
  voucherNo  String
  postedAt   DateTime @db.Timestamp(3) @default(now())

  @@unique([templateId, year, month])
}

model AuditLog {
  id            String           @id @default(uuid())
  voucherId     String
  voucher       Voucher          @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  action        AuditActionType
  userId        String?
  userName      String?
  changes       Json?
  reason        String?
  createdAt     DateTime         @db.Timestamp(3) @default(now())

  @@index([voucherId, createdAt])
  @@index([createdAt])
}

model VoucherReversal {
  id                    String   @id @default(uuid())
  originalVoucherId     String   @unique
  originalVoucher       Voucher  @relation("OriginalVoucher", fields: [originalVoucherId], references: [id], onDelete: Cascade)
  reversingVoucherId    String   @unique
  reversingVoucher      Voucher  @relation("ReversingVoucher", fields: [reversingVoucherId], references: [id], onDelete: Cascade)
  reason                String?
  createdBy             String?
  createdAt             DateTime @db.Timestamp(3) @default(now())

  @@index([originalVoucherId])
  @@index([reversingVoucherId])
}

model BusinessInfo {
  id                    String   @id @default(uuid())
  businessName          String?
  proprietorName        String?
  additionalProprietor  String?
  address               String?
  phone1                String?
  phone2                String?
  operationPass         String?
  createdAt             DateTime @db.Timestamp(3) @default(now())
  updatedAt             DateTime @db.Timestamp(3) @updatedAt

  @@index([createdAt])
}